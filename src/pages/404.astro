---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
---

<BaseLayout title="Paquete no encontrado · Luis Lezcano Tirado" description="Esta página no existe.">
  <Nav home={false} />
  <main id="contenido" class="lost">
    <div class="lost__label">
      <p class="lost__bar data">Rastreo · Error 404</p>
      <h1>Paquete no encontrado</h1>
      <p>La dirección que buscas no existe o cambió de lugar.</p>
      <a class="lost__btn" href="/">Volver al inicio</a>
    </div>
  </main>
</BaseLayout>

<style>
  .lost {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 7rem var(--gutter) 4rem;
    background: var(--tape);
  }
  .lost__label {
    width: min(100%, 40rem);
    background: var(--board);
    color: var(--ink);
    border: 3px solid var(--ink);
    display: grid;
    gap: 1.2rem;
    padding-bottom: 1.6rem;
  }
  .lost__label > :not(.lost__bar) {
    margin-inline: 1.6rem;
  }
  .lost__bar {
    padding: 0.5rem 1.2rem;
    background: var(--ink);
    color: var(--board);
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  h1 {
    font-size: var(--step-3);
    margin-top: 0.6rem;
  }
  .lost__btn {
    width: fit-content;
    padding: 0.8rem 1.3rem;
    background: var(--ink);
    color: var(--board);
    text-decoration: none;
    font-family: var(--font-display), sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.4rem;
    line-height: 1;
    transition: transform var(--dur-press) var(--ease-out);
  }
  .lost__btn:active {
    transform: scale(0.97);
  }
</style>
