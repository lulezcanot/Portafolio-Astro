---
import { profile } from '../data/profile';
import Barcode from './Barcode.astro';

const kinds = [
  { value: 'oportunidad', label: 'Una oportunidad' },
  { value: 'proyecto', label: 'Un proyecto' },
  { value: 'saludo', label: 'Solo saludar' },
];
---

<section class="contact on-tape seam" id="contacto">
  <div class="contact__inner">
    <h2 class="contact__title">Hablemos</h2>

    <div class="contact__side">
      <div class="contact__box" data-box="contacto" data-fold="1" data-close="1" data-ry="-24" data-size="0.9" aria-hidden="true"></div>

      <ul class="channels">
        <li>
          <button type="button" class="channel channel--copy" data-copy={profile.email}>
            <span class="channel__k data">Correo</span>
            <span class="channel__v" data-copy-label>{profile.email}</span>
            <span class="channel__hint data" aria-hidden="true">Copiar</span>
          </button>
        </li>
        <li>
          <a class="channel" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
            <span class="channel__k data">LinkedIn</span>
            <span class="channel__v">luis-lezcano-tirado</span>
            <span class="sr-only"> (abre en una pestaña nueva)</span>
          </a>
        </li>
        <li>
          <a class="channel" href={profile.links.github} target="_blank" rel="noopener noreferrer">
            <span class="channel__k data">GitHub</span>
            <span class="channel__v">lulezcanot</span>
            <span class="sr-only"> (abre en una pestaña nueva)</span>
          </a>
        </li>
        <li>
          <a class="channel" href={profile.links.instagram} target="_blank" rel="noopener noreferrer">
            <span class="channel__k data">Instagram</span>
            <span class="channel__v">@luis_lezcanot</span>
            <span class="sr-only"> (abre en una pestaña nueva)</span>
          </a>
        </li>
        <li>
          <a class="channel" href={profile.cv} download>
            <span class="channel__k data">Currículum</span>
            <span class="channel__v">Descargar CV (PDF)</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="slip">
      <div class="slip__bar data">
        <span>Despacho de mensaje</span>
        <span>Hacia {profile.city}</span>
      </div>

      <form class="form" data-contact novalidate>
        <div class="to">
          <span class="data">Destinatario</span>
          <p>{profile.name}</p>
        </div>

        <fieldset class="kind">
          <legend class="data">Tipo de envío</legend>
          <div class="kind__opts">
            {
              kinds.map((k, i) => (
                <label class="kind__opt">
                  <input type="radio" name="kind" value={k.value} checked={i === 0} />
                  <span>{k.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="field">
          <label class="data" for="c-name">Tu nombre</label>
          <input id="c-name" name="name" type="text" autocomplete="name" required maxlength="80" aria-describedby="e-name" />
          <p class="err" id="e-name" data-err="name"></p>
        </div>

        <div class="field">
          <label class="data" for="c-email">Tu correo</label>
          <input id="c-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="120" aria-describedby="e-email" />
          <p class="err" id="e-email" data-err="email"></p>
        </div>

        <div class="field">
          <label class="data" for="c-message">Contenido del mensaje</label>
          <textarea id="c-message" name="message" rows="5" required minlength="10" maxlength="2000" aria-describedby="e-message"></textarea>
          <p class="err" id="e-message" data-err="message"></p>
        </div>

        <div class="hp" aria-hidden="true">
          <label for="c-company">Empresa (no completar)</label>
          <input id="c-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="send">
          <button class="send__btn" type="submit" data-submit>
            <span data-submit-label>Despachar mensaje</span>
          </button>
          <Barcode seed="contacto-llt" height={34} label="LLT-CONTACTO" />
        </div>

        <div class="log data" role="status" aria-live="polite" data-log></div>
        <noscript>
          <p class="nojs">Necesitas JavaScript para enviar desde aquí. Escríbeme a <a href={`mailto:${profile.email}`}>{profile.email}</a>.</p>
        </noscript>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    --seam: var(--ink);
    position: relative;
    background: var(--tape);
    padding: clamp(5rem, 10vw, 8rem) var(--gutter) clamp(4rem, 8vw, 6rem);
  }
  .contact__inner {
    max-width: 82rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(2rem, 5vw, 5rem);
    row-gap: clamp(2rem, 4vw, 3rem);
  }
  .contact__title {
    grid-column: 1 / -1;
    font-size: var(--step-4);
  }
  .contact__side {
    display: grid;
    gap: 1.6rem;
    align-content: start;
  }
  .contact__box {
    min-height: 14rem;
    aspect-ratio: 1.55;
    margin-top: 1.75rem;
  }

  .channels {
    border-top: 3px solid var(--ink);
  }
  .channel {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    display: grid;
    grid-template-columns: 6.2rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.8rem 0.3rem;
    border-bottom: 3px solid var(--ink);
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color var(--dur-ui) var(--ease-out),
      color var(--dur-ui) var(--ease-out),
      padding var(--dur-ui) var(--ease-out);
  }
  .channel__v {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .channel__hint {
    font-weight: 700;
    opacity: 0.7;
  }
  .channel:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .channel:active {
    transform: scale(0.99);
  }
  @media (hover: hover) and (pointer: fine) {
    .channel:hover {
      background: var(--ink);
      color: var(--board);
      padding-inline: 0.8rem;
    }
  }

  .slip {
    background: var(--board);
    color: var(--ink);
    border: 3px solid var(--ink);
    box-shadow: 0 22px 40px -26px rgb(17 17 17 / 0.8);
  }
  .slip__bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 1rem;
    background: var(--ink);
    color: var(--board);
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .form {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.1rem, 2.6vw, 2rem);
  }
  .to {
    display: grid;
    gap: 0.1rem;
    padding-bottom: 0.9rem;
    border-bottom: 3px solid var(--ink);
  }
  .to .data {
    opacity: 0.7;
  }
  .to p {
    font-family: var(--font-display), sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    font-size: var(--step-2);
    line-height: 1;
  }

  .kind {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .kind legend {
    padding: 0;
    margin-bottom: 0.4rem;
    opacity: 0.7;
  }
  .kind__opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .kind__opt {
    position: relative;
  }
  .kind__opt input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .kind__opt span {
    display: block;
    padding: 0.45rem 0.9rem;
    border: 2px solid var(--ink);
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color var(--dur-ui) var(--ease-out),
      color var(--dur-ui) var(--ease-out),
      transform var(--dur-press) var(--ease-out);
  }
  .kind__opt input:checked + span {
    background: var(--ink);
    color: var(--board);
  }
  .kind__opt input:focus-visible + span {
    outline: 3px solid var(--tape-deep);
    outline-offset: 2px;
  }
  .kind__opt:active span {
    transform: scale(0.97);
  }

  .field {
    display: grid;
    gap: 0.3rem;
  }
  .field label {
    opacity: 0.7;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.7rem 0.8rem;
    background: transparent;
    border: 2px solid var(--ink);
    border-radius: 0;
    font-weight: 500;
    font-size: 1rem;
    transition:
      background-color var(--dur-ui) var(--ease-out),
      box-shadow var(--dur-ui) var(--ease-out);
  }
  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    background: #fff;
    box-shadow: inset 0 -5px 0 var(--tape);
  }
  .field [aria-invalid='true'] {
    border-color: #b3260f;
    background: #fff4f0;
  }
  .err {
    min-height: 0;
    color: #a3200c;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .err:empty {
    display: none;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .send {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.2rem;
    padding-top: 0.4rem;
  }
  .send__btn {
    position: relative;
    padding: 0.95rem 1.7rem 1.3rem;
    background: var(--ink);
    color: var(--board);
    border: 0;
    cursor: pointer;
    font-family: var(--font-display), sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.55rem;
    line-height: 1;
    letter-spacing: 0.02em;
    transition:
      transform var(--dur-press) var(--ease-out),
      background-color var(--dur-ui) var(--ease-out),
      color var(--dur-ui) var(--ease-out);
  }
  .send__btn::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 0.4rem;
    background: repeating-linear-gradient(135deg, var(--tape) 0 4px, var(--ink) 4px 8px);
  }
  .send__btn:active {
    transform: scale(0.97);
  }
  .send__btn:disabled {
    cursor: progress;
    background: var(--ink-soft);
  }
  @media (hover: hover) and (pointer: fine) {
    .send__btn:not(:disabled):hover {
      background: var(--tape);
      color: var(--ink);
      outline: 3px solid var(--ink);
      outline-offset: -3px;
    }
  }

  /* El estado se imprime como líneas de etiqueta térmica, no como alerta */
  .log {
    display: grid;
    gap: 0.15rem;
    min-height: 0;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .log:empty {
    display: none;
  }
  .log p {
    animation: line 360ms steps(12, end) both;
  }
  .log p[data-tone='ok'] {
    color: var(--film);
  }
  .log p[data-tone='error'] {
    color: #a3200c;
  }
  @keyframes line {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .log p {
      animation: none;
    }
  }
  .nojs {
    font-weight: 700;
  }

  @media (max-width: 560px) {
    .slip__bar span:last-child {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .contact__inner {
      grid-template-columns: 1fr;
    }
    .contact__box {
      min-height: 13rem;
    }
    .channel {
      grid-template-columns: 5.4rem minmax(0, 1fr);
    }
    .channel__hint {
      display: none;
    }
  }
</style>

<script>
  import { initContact } from '../scripts/contact';
  initContact();
</script>
