---
import { nav, profile } from '../data/profile';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const prefix = home ? '' : '/';
---

<header class="nav" data-nav>
  <div class="nav__bar">
    <a class="nav__brand" href={`${prefix}#inicio`} aria-label="Luis Lezcano Tirado, inicio">
      <span class="nav__mark" aria-hidden="true">LLT</span>
      <span class="nav__name">Luis Lezcano</span>
    </a>

    <nav class="nav__links" aria-label="Principal">
      <ul>
        {
          nav.map((l) => (
            <li>
              <a href={`${prefix}${l.href}`} data-nav-link={l.href.slice(1)}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="nav__cv data" href={profile.cv} download>CV</a>

    <button class="nav__toggle data" type="button" aria-expanded="false" aria-controls="nav-sheet" data-nav-toggle>
      <span data-nav-toggle-text>Menú</span>
    </button>
  </div>

  <div class="nav__sheet" id="nav-sheet" hidden data-nav-sheet>
    <ul>
      {
        nav.map((l) => (
          <li>
            <a href={`${prefix}${l.href}`} data-nav-sheet-link>
              {l.label}
            </a>
          </li>
        ))
      }
      <li><a href={profile.cv} download>Descargar CV</a></li>
    </ul>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0.9rem;
    left: 50%;
    z-index: 50;
    width: min(calc(100% - 2 * var(--gutter)), 60rem);
    translate: -50% 0;
    color: var(--ink);
  }
  .nav__bar {
    display: flex;
    align-items: stretch;
    background: var(--board);
    border: 2px solid var(--ink);
    box-shadow: 0 6px 18px -8px rgb(17 17 17 / 0.45);
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.35rem 0.9rem 0.35rem 0.35rem;
    text-decoration: none;
    margin-right: auto;
  }
  .nav__mark {
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--board);
    font-family: var(--font-display), sans-serif;
    font-weight: 900;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    line-height: 1;
  }
  .nav__name {
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.1rem;
  }
  .nav__links {
    display: flex;
  }
  .nav__links ul {
    display: flex;
  }
  .nav__links li {
    display: flex;
  }
  .nav__links a,
  .nav__cv,
  .nav__toggle {
    display: flex;
    align-items: center;
    align-self: stretch;
    padding: 0.6rem 1rem;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1;
    position: relative;
    transition:
      background-color var(--dur-ui) var(--ease-out),
      color var(--dur-ui) var(--ease-out);
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.35rem;
    height: 3px;
    background: var(--tape);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-ui) var(--ease-out);
  }
  .nav__links a[aria-current='true']::after {
    transform: scaleX(1);
  }
  .nav__cv {
    background: var(--tape);
    color: var(--ink);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }
  .nav__toggle {
    display: none;
    background: none;
    border: 0;
    border-left: 2px solid var(--ink);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav__links a:hover::after {
      transform: scaleX(1);
    }
    .nav__cv:hover {
      background: var(--ink);
      color: var(--board);
    }
  }
  .nav__links a:active,
  .nav__cv:active,
  .nav__toggle:active {
    transform: scale(0.97);
  }

  .nav__sheet {
    margin-top: 0.4rem;
    background: var(--board);
    border: 2px solid var(--ink);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 240ms var(--ease-out);
  }
  .nav__sheet.is-open {
    clip-path: inset(0 0 0 0);
  }
  .nav__sheet[hidden] {
    display: none;
  }
  .nav__sheet a {
    display: block;
    padding: 1rem 1.1rem;
    text-decoration: none;
    font-family: var(--font-display), sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.9rem;
    line-height: 1;
    border-bottom: 2px solid var(--ink);
  }
  .nav__sheet li:last-child a {
    border-bottom: 0;
    background: var(--ink);
    color: var(--board);
  }

  @media (max-width: 820px) {
    .nav__links,
    .nav__cv {
      display: none;
    }
    .nav__toggle {
      display: flex;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = nav?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const sheet = nav?.querySelector<HTMLElement>('[data-nav-sheet]');
  const text = nav?.querySelector<HTMLElement>('[data-nav-toggle-text]');

  const setOpen = (open: boolean) => {
    if (!toggle || !sheet || !text) return;
    toggle.setAttribute('aria-expanded', String(open));
    text.textContent = open ? 'Cerrar' : 'Menú';
    if (open) {
      sheet.hidden = false;
      requestAnimationFrame(() => sheet.classList.add('is-open'));
    } else {
      sheet.classList.remove('is-open');
      setTimeout(() => {
        if (toggle.getAttribute('aria-expanded') === 'false') sheet.hidden = true;
      }, 240);
    }
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  sheet?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  // Sección activa
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const ids = links.map((l) => l.dataset.navLink!).filter(Boolean);
  const sections = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (sections.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.navLink === en.target.id)));
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
